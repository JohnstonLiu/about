{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "selfCloseVoidElements": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/about/src/pages/index.astro"],
      "linter": {
        "rules": {
          "a11y": {
            "noAmbiguousAnchorText": "off"
          }
        }
      }
    }
  ]
}
