---
import SharedHead from "@johnstonliu/shared/SharedHead.astro";
import { SITE } from "../siteConfig";
import "../styles/global.css";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const linkClass = "text-blue-400 hover:text-blue-300 underline";
const bodyClass = "text-base sm:text-lg leading-relaxed";

const contactLinks = [
  {
    href: "mailto:johnstonliu2004@gmail.com",
    label: "Email",
    iconWidth: 512,
    iconPath:
      "M48 64c-26.5 0-48 21.5-48 48 0 15.1 7.1 29.3 19.2 38.4l208 156c17.1 12.8 40.5 12.8 57.6 0l208-156c12.1-9.1 19.2-23.3 19.2-38.4 0-26.5-21.5-48-48-48L48 64zM0 196L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-188-198.4 148.8c-34.1 25.6-81.1 25.6-115.2 0L0 196z",
  },
  {
    href: "https://github.com/JohnstonLiu",
    label: "GitHub",
    iconWidth: 512,
    iconPath:
